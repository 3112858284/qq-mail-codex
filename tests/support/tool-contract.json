          }
        },
        "subject": {
          "default": "",
          "type": "string",
          "maxLength": 998
        },
        "text": {
          "type": "string",
          "maxLength": 524288
        },
        "replyToMessage": {
          "type": "object",
          "properties": {
            "folder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "uidValidity": {
              "type": "string",
              "pattern": "^[1-9]\\d{0,30}$"
            },
            "uid": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "folder",
            "uidValidity",
            "uid"
          ]
        }
      },
      "required": [
        "text"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
