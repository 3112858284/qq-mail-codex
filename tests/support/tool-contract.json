  {
    "name": "search_messages",
    "inputSchema": {
      "type": "object",
      "properties": {
        "folder": {
          "default": "INBOX",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "from": {
          "type": "string",
          "maxLength": 254
        },
        "to": {
          "type": "string",
          "maxLength": 254
        },
        "subject": {
          "type": "string",
          "maxLength": 998
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "before": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "unread": {
          "type": "boolean"
        },
        "pageSize": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "get_message",
    "inputSchema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "object",
          "properties": {
            "folder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "uidValidity": {
              "type": "string",
              "pattern": "^[1-9]\\d{0,30}$"
            },
            "uid": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "folder",
            "uidValidity",
            "uid"
          ]
        }
      },
      "required": [
        "message"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
