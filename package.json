{
  "name": "qq-mail-codex-plugin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "start": "node dist/cli/serve.js",
    "check": "node dist/cli/check.js",
    "read-mail": "node dist/cli/read-mail.js",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "imapflow": "2.4.2",
    "html-to-text": "10.0.1",
    "mailparser": "3.9.39",
    "nodemailer": "10.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/nodemailer": "7.0.12",
    "@types/mailparser": "3.9.0",
    "typescript": "7.0.2"
  }
}
